[node name="Label" type="Label" parent="MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" unique_id=1266612497]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Your objective is to fill the board with suns and moons. Every puzzle has one unique solution that is guaranteed to be solvable.

There are four rules you must follow while filling the board:

Rule 1: Each row and column must have an equal amount of suns and moons.
For example, on a 6x6 board, each row and column must have 3 suns and 3 moons.

Rule 2: No more than two symbols can be in a row.
Three or more cannot be together. Diagonal lines are OK.

Rule 3: Tiles with an equal sign (=) between them must be the same symbol.

Rule 4: Tiles with an X between them must be the opposite symbol.

Click or tap on an empty tile to turn it into a sun. Click or tap a sun tile to turn it into a moon."
autowrap_mode = 2
